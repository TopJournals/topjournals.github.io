---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PublicationCard from '../../components/PublicationCard.astro';
import SectionIntro from '../../components/SectionIntro.astro';
import {
  publicationDesignCategories,
  publicationResearchCategories,
  publicationYears,
  publications
} from '../../data/publications';
---

<BaseLayout title="Publications | Metastructure Lab">
  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:px-8">
    <SectionIntro
      eyebrow="Research output"
      title="Publications"
    />

    <div class="mb-8 grid gap-4 rounded border border-slate-200 bg-slate-50 p-4 sm:grid-cols-2 lg:grid-cols-4">
      <label class="block">
        <span class="mb-1 block text-xs font-semibold uppercase tracking-[0.12em] text-slate-500">Search</span>
        <input id="publication-search" class="focus-ring w-full rounded border border-slate-300 bg-white px-3 py-2 text-sm" type="search" placeholder="Title, author, venue, category" />
      </label>
      <label class="block">
        <span class="mb-1 block text-xs font-semibold uppercase tracking-[0.12em] text-slate-500">Year</span>
        <select id="publication-year" class="focus-ring w-full rounded border border-slate-300 bg-white px-3 py-2 text-sm">
          <option value="">All years</option>
          {publicationYears.map((year) => <option value={year}>{year}</option>)}
        </select>
      </label>
      <label class="block">
        <span class="mb-1 block text-xs font-semibold uppercase tracking-[0.12em] text-slate-500">Research</span>
        <select id="publication-research" class="focus-ring w-full rounded border border-slate-300 bg-white px-3 py-2 text-sm">
          <option value="">All research</option>
          {publicationResearchCategories.map((category) => <option value={category.toLowerCase()}>{category}</option>)}
        </select>
      </label>
      <label class="block">
        <span class="mb-1 block text-xs font-semibold uppercase tracking-[0.12em] text-slate-500">Design</span>
        <select id="publication-design" class="focus-ring w-full rounded border border-slate-300 bg-white px-3 py-2 text-sm">
          <option value="">All design</option>
          {publicationDesignCategories.map((category) => <option value={category.toLowerCase()}>{category}</option>)}
        </select>
      </label>
    </div>

    <p id="publication-count" class="mb-3 text-sm font-medium text-slate-500">{publications.length} publications</p>

    <div id="publication-list" class="space-y-4">
      {publications.map((publication) => <PublicationCard publication={publication} />)}
    </div>
    <p id="publication-empty" class="hidden rounded border border-slate-200 bg-slate-50 p-6 text-slate-600">No publications match the current filters.</p>

  </section>

  <script>
    const searchInput = document.querySelector<HTMLInputElement>('#publication-search');
    const yearSelect = document.querySelector<HTMLSelectElement>('#publication-year');
    const researchSelect = document.querySelector<HTMLSelectElement>('#publication-research');
    const designSelect = document.querySelector<HTMLSelectElement>('#publication-design');
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.publication-card'));
    const count = document.querySelector<HTMLElement>('#publication-count');
    const empty = document.querySelector<HTMLElement>('#publication-empty');

    function applyFilters() {
      if (!searchInput || !yearSelect || !researchSelect || !designSelect || !count || !empty) return;

      const query = searchInput.value.trim().toLowerCase();
      const year = yearSelect.value;
      const research = researchSelect.value;
      const design = designSelect.value;
      let visible = 0;

      for (const card of cards) {
        const haystack = `${card.dataset.title} ${card.dataset.authors} ${card.textContent}`.toLowerCase();
        const matchesQuery = !query || haystack.includes(query);
        const matchesYear = !year || card.dataset.year === year;
        const matchesResearch = !research || card.dataset.research === research;
        const matchesDesign = !design || Boolean(card.dataset.design?.includes(design));
        const show = matchesQuery && matchesYear && matchesResearch && matchesDesign;
        card.classList.toggle('hidden', !show);
        card.style.display = show ? '' : 'none'; // Ensure display none is set if card doesn't use standard hidden class
        if (show) visible += 1;
      }

      count.textContent = `${visible} publication${visible === 1 ? '' : 's'}`;
      empty.classList.toggle('hidden', visible !== 0);
    }

    searchInput?.addEventListener('input', applyFilters);
    yearSelect?.addEventListener('change', applyFilters);
    researchSelect?.addEventListener('change', applyFilters);
    designSelect?.addEventListener('change', applyFilters);
  </script>
</BaseLayout>
