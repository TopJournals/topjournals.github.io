---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionIntro from '../../../components/SectionIntro.astro';
import { conferenceActivities } from '../../../data/conference';
import { highlightDaweiLi } from '../../../utils/highlightName';

const highlightedConference = conferenceActivities.map((item) => ({
  ...item,
  contributorsHtml: highlightDaweiLi(item.contributors)
}));
---

<BaseLayout title="Conference Papers & Presentations | Metastructure Lab">
  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:px-8">
    <SectionIntro
      eyebrow="Publications"
      title="Conference Papers & Presentations"
    />

    <div class="space-y-6">
      {highlightedConference.map((item) => (
        <article class="hover-card rounded border border-slate-200 bg-white p-6 shadow-sm">
          <div class="mb-3 flex flex-wrap items-center gap-3">
            <span class="rounded bg-blue-50 px-2 py-1 text-xs font-semibold text-academic-blue">{item.type}</span>
            <span class="rounded bg-slate-100 px-2 py-1 text-xs font-semibold text-slate-600">{item.date}</span>
          </div>
          <h2 class="text-xl font-bold leading-snug text-academic-heading">{item.title}</h2>
          <p class="mt-3 text-sm text-slate-600" set:html={item.contributorsHtml} />
          <p class="mt-1 text-sm text-slate-500">{item.venue}, {item.location}</p>
          {item.url && (
            <a
              href={item.url}
              target="_blank"
              rel="noreferrer"
              class="mt-4 inline-flex rounded bg-academic-blue px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-blue-800"
            >
              View details
            </a>
          )}
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
