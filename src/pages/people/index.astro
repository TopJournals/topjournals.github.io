---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionIntro from '../../components/SectionIntro.astro';
import { people } from '../../data/people';
import { biography, professionalActivities, site } from '../../data/site';
import { highlightDaweiLi } from '../../utils/highlightName';

const highlightedLeader = highlightDaweiLi(site.leader);
const highlightedBiography = biography.map((paragraph) => highlightDaweiLi(paragraph));
const highlightedActivities = professionalActivities.map((activity) => highlightDaweiLi(activity));
const currentStudents = people.filter(p => p.status === 'current');
const graduatedStudents = people.filter(p => p.status === 'graduated');
---

<BaseLayout title="People | Metastructure Lab">
  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:px-8">
    <SectionIntro
      eyebrow="Team"
      title="People"
    />
    <article class="hover-card mb-8 rounded border border-slate-200 bg-slate-50 p-6 shadow-sm">
      <div class="flex items-start gap-4">
        <img
          src={site.leaderAvatar}
          alt={`${site.leader} avatar`}
          class="w-32 h-32 shrink-0 rounded-full border border-slate-200 bg-slate-50 object-cover shadow-sm"
        />
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.14em] text-academic-blue">Principal Investigator</p>
          <h2 class="mt-2 text-2xl font-bold text-academic-heading"><span set:html={highlightedLeader} /> <span class="text-slate-400">{site.leaderChinese}</span></h2>
          <p class="mt-2 text-slate-600">{site.affiliation}</p>
          <a href={`mailto:${site.email}`} class="mt-3 inline-flex text-sm font-semibold text-academic-blue hover:underline">{site.email}</a>
        </div>
      </div>
    </article>
    <div class="mb-10 grid gap-6 lg:grid-cols-[1.1fr_0.9fr]">
      <article class="hover-card rounded border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="text-xl font-bold text-academic-heading">Biography</h2>
        <div class="mt-4 space-y-4">
          {highlightedBiography.map((paragraph) => (
            <p class="text-slate-600" set:html={paragraph} />
          ))}
        </div>
      </article>
      <article class="hover-card rounded border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="text-xl font-bold text-academic-heading">Professional Activities</h2>
        <div class="mt-4 space-y-4">
          {highlightedActivities.map((activity) => (
            <p class="text-slate-600" set:html={activity} />
          ))}
        </div>
      </article>
    </div>

    <h2 class="mb-4 text-xl font-bold text-academic-heading">Current Students <span class="text-slate-400 font-normal">在读学生</span></h2>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 mb-12">
      {currentStudents.map((person) => (
        <article class="hover-card flex items-start gap-3 rounded border border-slate-200 bg-white p-4 shadow-sm">
          <img
            src={person.avatar}
            alt={`${person.name} cartoon cat avatar`}
            class="h-14 w-14 shrink-0 rounded-full border border-slate-200 bg-slate-50 object-cover shadow-sm"
            loading="lazy"
          />
          <div class="min-w-0 pt-0.5">
            <h2 class="font-bold text-academic-heading text-sm sm:text-base">{person.name}</h2>
            <p class="mt-0.5 text-xs text-slate-600">{person.role}</p>
            <p class="mt-2 text-[10px] font-semibold uppercase tracking-[0.12em] text-slate-400">Since {person.start}</p>
            {(person.scholarUrl || person.researchGateUrl) && (
              <div class="mt-2 flex items-center gap-2">
                {person.scholarUrl && (
                  <a
                    href={person.scholarUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-[10px] text-academic-blue hover:underline flex items-center gap-1"
                    title="Google Scholar"
                  >
                    Scholar
                  </a>
                )}
                {person.researchGateUrl && (
                  <a
                    href={person.researchGateUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-[10px] text-academic-blue hover:underline flex items-center gap-1"
                    title="ResearchGate"
                  >
                    RG
                  </a>
                )}
              </div>
            )}
          </div>
        </article>
      ))}
    </div>

    {graduatedStudents.length > 0 && (
      <>
        <h2 class="mb-4 text-xl font-bold text-academic-heading">Graduated Students <span class="text-slate-400 font-normal">已毕业学生</span></h2>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 mb-12">
          {graduatedStudents.map((person) => (
            <article class="hover-card flex items-start gap-3 rounded border border-slate-200 bg-white p-4 shadow-sm">
              <img
                src={person.avatar}
                alt={`${person.name} cartoon cat avatar`}
                class="h-14 w-14 shrink-0 rounded-full border border-slate-200 bg-slate-50 object-cover shadow-sm"
                loading="lazy"
              />
              <div class="min-w-0 pt-0.5">
                <h2 class="font-bold text-academic-heading text-sm sm:text-base">{person.name}</h2>
                <p class="mt-0.5 text-xs text-slate-600">{person.role}</p>
                <p class="mt-2 text-[10px] font-semibold text-academic-blue">{person.start} - {person.graduationDate}</p>
                {person.destination && (
                  <p class="mt-1 text-[10px] text-slate-500 italic truncate" title={person.destination}>{person.destination}</p>
                )}
                {(person.scholarUrl || person.researchGateUrl) && (
                  <div class="mt-2 flex items-center gap-2">
                    {person.scholarUrl && (
                      <a
                        href={person.scholarUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-[10px] text-academic-blue hover:underline flex items-center gap-1"
                        title="Google Scholar"
                      >
                        Scholar
                      </a>
                    )}
                    {person.researchGateUrl && (
                      <a
                        href={person.researchGateUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-[10px] text-academic-blue hover:underline flex items-center gap-1"
                        title="ResearchGate"
                      >
                        RG
                      </a>
                    )}
                  </div>
                )}
              </div>
            </article>
          ))}
        </div>
      </>
    )}
  </section>
</BaseLayout>
