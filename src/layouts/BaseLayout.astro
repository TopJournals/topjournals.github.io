---
import '../styles/global.css';
import { site } from '../data/site';

type Props = {
  title?: string;
  description?: string;
};

type NavChild = {
  href: string;
  label: string;
};

type NavItem = {
  href: string;
  label: string;
  children?: NavChild[];
};

type MobileNavItem = {
  href: string;
  label: string;
  mobileChild?: boolean;
};

const { title = site.title, description = site.description } = Astro.props;
const navItems: NavItem[] = [
  { href: '/', label: 'Home' },
  { href: '/research/', label: 'Research' },
  {
    href: '/publications/',
    label: 'Publications',
    children: [
      { href: '/publications/', label: 'Papers' },
      { href: '/publications/conferences/', label: 'Conference Papers & Presentations' },
      { href: '/publications/software/', label: 'Software' },
      { href: '/publications/patents/', label: 'Patents' }
    ]
  },
  { href: '/resources/', label: 'Resources' },
  { href: '/people/', label: 'People' },
  { href: '/honors/', label: 'Honors' },
  { href: '/news/', label: 'News' }
];
const mobileNavItems: MobileNavItem[] = navItems.flatMap((item) =>
  item.children
    ? [{ href: item.href, label: item.label }, ...item.children.map((child) => ({ ...child, mobileChild: true }))]
    : [{ href: item.href, label: item.label }]
);

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" href="/assets/original/site/favicon.ico" />
    <title>{title}</title>
  </head>
  <body class="antialiased">
    <nav id="main-nav" class="academic-nav fixed left-0 top-0 z-50 w-full">
      <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6 lg:px-8">
        <a href="/" class="focus-ring flex items-center gap-2.5 rounded">
          <img src="/assets/original/site/favicon.ico" alt="" class="h-7 w-7 object-contain" />
          <span class="text-base font-bold tracking-tight" style="color: var(--text-primary)">
            Metastructure<span class="gradient-text">Lab</span>
          </span>
        </a>
        <div class="hidden items-center gap-8 md:flex">
          {navItems.map((item) => (
            item.children ? (
              <div class="nav-group relative">
                <a
                  href={item.href}
                  class="nav-link focus-ring inline-flex items-center gap-1 rounded pb-1"
                >
                  {item.label}
                  <svg viewBox="0 0 20 20" aria-hidden="true" class="h-3.5 w-3.5 opacity-60">
                    <path d="M5.5 7.5 10 12l4.5-4.5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75"></path>
                  </svg>
                </a>
                <div class="nav-dropdown absolute left-0 top-full min-w-[280px] pt-3">
                  <div class="rounded-xl border border-slate-200 bg-white/95 p-1.5 shadow-xl backdrop-blur-lg">
                    {item.children.map((child) => (
                      <a
                        href={child.href}
                        class="focus-ring block rounded-lg px-3 py-2 text-sm font-medium text-slate-600 transition-colors hover:bg-blue-50 hover:text-blue-700"
                      >
                        {child.label}
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            ) : (
              <a
                href={item.href}
                class="nav-link focus-ring rounded pb-1"
                aria-current={currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href)) ? 'page' : undefined}
              >
                {item.label}
              </a>
            )
          ))}
        </div>
      </div>
      <div class="flex gap-5 overflow-x-auto border-t border-slate-100 px-4 py-2 md:hidden">
        {mobileNavItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              'whitespace-nowrap text-sm font-medium text-slate-600',
              item.mobileChild ? 'pl-2 text-slate-400' : ''
            ]}
          >
            {item.label}
          </a>
        ))}
      </div>
    </nav>

    <main class="pt-24 md:pt-16">
      <slot />
    </main>

    <footer class="mt-12 border-t border-slate-200 bg-slate-50">
      <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
        <div class="flex flex-col gap-6 md:flex-row md:items-start md:justify-between">
          <div>
            <div class="flex items-center gap-2 mb-2">
              <img src="/assets/original/site/favicon.ico" alt="" class="h-5 w-5 object-contain opacity-70" />
              <span class="font-bold text-slate-800">Metastructure Lab</span>
            </div>
            <p class="text-sm text-slate-500">{site.affiliation}</p>
            <p class="mt-1 text-sm text-slate-400">{site.address}</p>
          </div>
          <div class="flex flex-wrap gap-x-8 gap-y-3 text-sm">
            <div class="flex flex-col gap-1">
              <span class="text-xs font-semibold uppercase tracking-widest text-slate-400">Contact</span>
              <a href={`mailto:${site.email}`} class="text-slate-600 hover:text-blue-600 transition-colors">{site.email}</a>
            </div>
            <div class="flex flex-col gap-1">
              <span class="text-xs font-semibold uppercase tracking-widest text-slate-400">Profiles</span>
              <a href={site.scholarUrl} target="_blank" rel="noreferrer" class="text-slate-600 hover:text-blue-600 transition-colors">Google Scholar</a>
              <a href={site.researchGateUrl} target="_blank" rel="noreferrer" class="text-slate-600 hover:text-blue-600 transition-colors">ResearchGate</a>
            </div>
            <div class="flex flex-col gap-1">
              <span class="text-xs font-semibold uppercase tracking-widest text-slate-400">Site</span>
              <a href="/honors/" class="text-slate-600 hover:text-blue-600 transition-colors">Honors</a>
              <a href="/news/" class="text-slate-600 hover:text-blue-600 transition-colors">News</a>
            </div>
          </div>
        </div>
        <div class="mt-8 border-t border-slate-200 pt-5 text-xs text-slate-400">
          © {new Date().getFullYear()} Metastructure Lab · Nanjing University of Science and Technology
        </div>
      </div>
    </footer>

    <script>
      // Scroll-aware navbar
      const nav = document.getElementById('main-nav');
      const onScroll = () => nav?.classList.toggle('scrolled', window.scrollY > 20);
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      // Scroll-reveal
      const revealEls = document.querySelectorAll<HTMLElement>('.reveal');
      if (revealEls.length) {
        const io = new IntersectionObserver(
          (entries) => entries.forEach(e => e.isIntersecting && e.target.classList.add('visible')),
          { threshold: 0.12 }
        );
        revealEls.forEach(el => io.observe(el));
      }
    </script>
  </body>
</html>
