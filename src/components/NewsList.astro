---
import type { NewsItem } from '../data/news';
import { highlightDaweiLi } from '../utils/highlightName';

type Props = {
  items: NewsItem[];
};

const { items } = Astro.props;
const monthLabels = ['Jan.', 'Feb.', 'Mar.', 'Apr.', 'May.', 'Jun.', 'Jul.', 'Aug.', 'Sept.', 'Oct.', 'Nov.', 'Dec.'];
const formatNewsDate = (date: string) => {
  const match = date.match(/^(\d{4})-(\d{2})-(\d{2})$/);
  if (!match) return date;

  const [, year, month, day] = match;
  return `${monthLabels[Number(month) - 1]} ${Number(day)}, ${year}`;
};

const getTitle = (item: NewsItem) => {
  if (item.title) return item.title;
  if (/accepted in|published in|accepted to/i.test(item.text)) {
    const journalMatch = item.text.match(/(?:accepted in|published in|accepted to)\s*([“"][^”"]+[”"]|[A-Z][A-Za-z0-9\s:&.-]+?)(?:\.|\s*🎉|$)/i);
    if (journalMatch) {
      return `论文发表于 ${journalMatch[1].replace(/[“”"]/g, '').trim()}`;
    }
    return '论文发表';
  }
  if (/特等奖|一等奖|二等奖|三等奖|毕设|比赛|竞赛/i.test(item.text)) {
    return '获得学术与竞赛荣誉';
  }
  return '最新动态';
};
---

<div class="flex flex-col gap-3.5">
  {items.map((item) => {
    const title = getTitle(item);
    return (
      <article
        class={`hover-card group rounded-xl border p-4 sm:p-5 transition-all duration-200 ${
          item.highlight
            ? 'border-blue-200/90 bg-white hover:border-blue-300 shadow-xs'
            : 'border-slate-200/80 bg-white hover:border-slate-300 shadow-xs'
        }`}
      >
        <div class="flex flex-col gap-2.5 sm:flex-row sm:items-start sm:gap-6">
          <!-- Left: Date -->
          <div class="shrink-0 sm:w-36 pt-0.5">
            <time
              datetime={item.date}
              class="inline-flex items-center gap-1.5 rounded-md border border-slate-200/80 bg-slate-50 px-2.5 py-1 text-xs font-semibold text-slate-700 font-mono tracking-tight"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-blue-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              <span>{formatNewsDate(item.date)}</span>
            </time>
          </div>

          <!-- Right: Two rows (Row 1: Title, Row 2: Content) -->
          <div class="min-w-0 flex-1 space-y-1.5">
            <!-- Row 1: Title -->
            <div class="flex flex-wrap items-center gap-2">
              <h3 class="text-base font-bold leading-snug text-academic-heading group-hover:text-blue-700 transition-colors">
                {title}
              </h3>
              {item.highlight && (
                <span class="rounded border border-blue-100 bg-blue-50 px-2 py-0.5 text-xs font-semibold text-academic-blue">
                  Featured
                </span>
              )}
            </div>

            <!-- Row 2: Content -->
            <p class="text-sm leading-relaxed text-slate-600" set:html={highlightDaweiLi(item.text)} />
          </div>
        </div>
      </article>
    );
  })}
</div>
